{
  "expo": {
    "name": "Seller",
    "slug": "admin-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "adminapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.ecommerce.admin",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#2E7D32",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E7D32",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/order_ring.wav"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow the app to use the camera to scan product barcodes.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow the app to use your location to set the shop's location pin on the map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "firebase": {
        "apiKey": "AIzaSyBIdAjxAWzN5NjNqww4h7xO5xEgW2fZHus",
        "authDomain": "ecommerce-rajendran.firebaseapp.com",
        "projectId": "ecommerce-rajendran",
        "storageBucket": "ecommerce-rajendran.firebasestorage.app",
        "messagingSenderId": "376909191923",
        "appId": "1:376909191923:android:f5f48bbb0f457ba4d5f586"
      },
      "googleWebClientId": "376909191923-ijjq7hsvjsql3imgfc8h70sucg3cefju.apps.googleusercontent.com",
      "shopId": "main",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "77dc3e89-717f-45df-ad4e-818b13d7c57a"
      }
    },
    "owner": "mkencom"
  }
}
