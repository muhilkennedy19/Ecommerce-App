  <!-- ===================================================================== -->
  <!-- PAGE 3 — PUSH NOTIFICATION ARCHITECTURE                               -->
  <!-- ===================================================================== -->
  <diagram id="page-push" name="3 · Push &amp; Email Pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p3-title" value="Push &amp; Email Pipeline — FCM HTTP v1 via Cloudflare Worker (no Blaze plan required)" style="text;html=1;align=center;fontSize=19;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1290" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p3-s1" value="A · TOKEN REGISTRATION" style="text;html=1;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p3-1" value="App sign-in (buyer or admin)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;AuthProvider detects Firebase user&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3-2" value="registerForPush(uid[, roles])&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;expo-notifications&lt;br/&gt;requestPermissionsAsync()&lt;br/&gt;getDevicePushTokenAsync() → FCM token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p3-3" value="Admin only: create channel &quot;orders&quot;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;importance MAX · order_ring.wav&lt;br/&gt;custom vibration pattern&lt;br/&gt;notification handler shows banner + sound&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="295" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-4" value="pushTokens/{uid}&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;{ token, kind: &quot;admin&quot;|&quot;buyer&quot;,&lt;br/&gt;role, roles[], notify, updatedAt }&lt;br/&gt;&lt;i&gt;rule: only the owner may write&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="180" width="250" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p3-s2" value="B · TRIGGERS" style="text;html=1;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="330" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p3-5" value="&lt;b&gt;Event sources&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• buyer placed an order → &lt;b&gt;new-order&lt;/b&gt;&lt;br/&gt;• admin changed status → &lt;b&gt;order-status&lt;/b&gt;&lt;br/&gt;• product restocked → &lt;b&gt;back-in-stock&lt;/b&gt;&lt;br/&gt;• welcome / order bill → &lt;b&gt;email&lt;/b&gt;&lt;br/&gt;• cron sweep → repeat &lt;b&gt;new-order&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="360" width="250" height="125" as="geometry" />
        </mxCell>

        <mxCell id="p3-s3" value="C · CLIENT → WORKER" style="text;html=1;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="150" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p3-6" value="common/util/notify.ts&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;sendNotify(event) / sendEmail()&lt;br/&gt;POST {notifyUrl} with&lt;br/&gt;Authorization: Bearer &amp;lt;Firebase ID token&amp;gt;&lt;br/&gt;&lt;i&gt;fire-and-forget — never blocks the UI&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="640" y="180" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3-7" value="&lt;b&gt;Cloudflare Worker · functions/notify/src&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1. parse body, check Bearer token&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;⚠ claims-only (aud/iss/exp), no signature verify&lt;br/&gt;2. sign service-account JWT (Web Crypto)&lt;br/&gt;3. exchange for Google OAuth2 access token&lt;br/&gt;4. resolve recipients via Firestore REST&lt;br/&gt;5. POST FCM v1 messages:send per token&lt;br/&gt;6. return { sent, failed }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="330" width="260" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p3-8" value="⏱ scheduled() — cron &quot;* * * * *&quot;&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;scan orders status = &quot;new&quot;&lt;br/&gt;age &amp;gt; 30 s and reminders &amp;lt; 15&lt;br/&gt;→ re-notify admins, bump counter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="540" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p3-s4" value="D · GOOGLE APIS &amp; DELIVERY" style="text;html=1;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="150" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p3-9" value="Google OAuth2&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;oauth2.googleapis.com/token&lt;br/&gt;secret: FIREBASE_SERVICE_ACCOUNT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="960" y="180" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p3-10" value="Firestore REST&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;GET pushTokens/{uid}&lt;br/&gt;runQuery: customers where&lt;br/&gt;notifyBackInStock ARRAY_CONTAINS productId&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="960" y="270" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p3-11" value="FCM HTTP v1&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;projects/{projectId}/messages:send&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="960" y="385" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3-12" value="Gmail API&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;GMAIL_CLIENT_ID / SECRET /&lt;br/&gt;REFRESH_TOKEN / SENDER&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="960" y="470" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p3-13" value="🔔 Admin devices&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ringing order alert, works in background&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="960" y="585" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3-14" value="📱 Buyer devices&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;order-status / back-in-stock&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="960" y="665" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p3-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p3-1" target="p3-2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p3-2" target="p3-3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e3" value="setPushToken()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;" edge="1" parent="1" source="p3-2" target="p3-4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p3-5" target="p3-6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="p3-6" target="p3-7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e6" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;" edge="1" parent="1" source="p3-7" target="p3-9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e7" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;" edge="1" parent="1" source="p3-7" target="p3-10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e8" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="p3-7" target="p3-11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="p3-7" target="p3-12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="p3-11" target="p3-13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="p3-11" target="p3-14"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="p3-8" target="p3-7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e13" value="read tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=9;" edge="1" parent="1" source="p3-4" target="p3-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455" y="150" /><mxPoint x="1080" y="150" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="p3-risk" value="&lt;b&gt;⚠ Hardening required before public launch:&lt;/b&gt; the Worker accepts any syntactically valid ID token without RS256 signature verification, so an attacker who knows the notify URL can trigger arbitrary pushes and emails. Verify the token against Google&#39;s public JWKs (or add a shared secret / Cloudflare Access) before going to Production." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="880" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===================================================================== -->
  <!-- PAGE 4 — AUTH & RBAC                                                  -->
  <!-- ===================================================================== -->
  <diagram id="page-auth" name="4 · Auth &amp; RBAC">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p4-title" value="Authentication &amp; Role-Based Access Control" style="text;html=1;align=center;fontSize=19;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1290" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p4-1" value="Tap &quot;Sign in with Google&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="240" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p4-2" value="@react-native-google-signin&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;configured with googleWebClientId&lt;br/&gt;(OAuth client_type 3 from google-services.json)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p4-3" value="Firebase Auth&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;signInWithCredential(idToken)&lt;br/&gt;→ User { uid, email, displayName }&lt;br/&gt;session persisted via AsyncStorage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p4-4" value="subscribeToAuth() fires" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="385" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4-5" value="Which app?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="110" y="455" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- buyer branch -->
        <mxCell id="p4-b1" value="BUYER" style="text;html=1;align=center;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="440" width="260" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p4-b2" value="upsertCustomerForUser(shopId, uid)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;creates/merges customers/{uid}&lt;br/&gt;(doc id == uid, so rules allow self-access)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="470" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4-b3" value="registerForPush(uid) → pushTokens/{uid} kind=&quot;buyer&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="560" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4-b4" value="first sign-in → welcome email (Worker, best-effort)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="630" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4-b5" value="→ /(shop)/(tabs)/home&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;no role needed — every signed-in user can shop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="700" width="260" height="55" as="geometry" />
        </mxCell>

        <!-- admin branch -->
        <mxCell id="p4-a1" value="ADMIN" style="text;html=1;align=center;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="90" width="260" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p4-a2" value="fetchAppUser(uid) → users/{uid}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p4-a3" value="doc exists&lt;br/&gt;with a role?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="195" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-a4" value="NO → upsertPendingUser()&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;pendingUsers/{uid} = { email, name }&lt;br/&gt;stay on sign-in: &quot;waiting for approval&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="380" y="310" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4-a5" value="Manager opens (app)/roles&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;needs permission roles.manage&lt;br/&gt;grants role → writes users/{uid}&lt;br/&gt;only a superuser can mint a superuser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="700" y="310" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-a6" value="YES → (app)/dashboard&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;registerForPush(uid, roles) → pushTokens kind=&quot;admin&quot;&lt;br/&gt;UI gated by userHasPermission()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="700" y="120" width="260" height="75" as="geometry" />
        </mxCell>

        <!-- role matrix -->
        <mxCell id="p4-roles" value="&lt;b&gt;Roles → permissions (common/src/roles)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;superuser&lt;/b&gt; — everything, bypasses the &lt;i&gt;active&lt;/i&gt; flag&lt;br/&gt;&lt;b&gt;admin&lt;/b&gt; — shop.config, sales.discount, sales.override, roles.manage, reads&lt;br/&gt;&lt;b&gt;product-manager&lt;/b&gt; — products.read/write, categories.write&lt;br/&gt;&lt;b&gt;employee-manager&lt;/b&gt; — employees.read/write, roles.manage&lt;br/&gt;&lt;b&gt;customer-manager&lt;/b&gt; — customers.read/write&lt;br/&gt;&lt;b&gt;sales&lt;/b&gt; — orders.read, orders.serve&lt;br/&gt;&lt;b&gt;analytics&lt;/b&gt; — analytics.read, orders.read&lt;br/&gt;&lt;br/&gt;Multi-role: &lt;i&gt;roles[]&lt;/i&gt; is evaluated as a union; legacy single &lt;i&gt;role&lt;/i&gt; is the fallback.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1000" y="120" width="320" height="230" as="geometry" />
        </mxCell>

        <mxCell id="p4-enf" value="&lt;b&gt;Two-layer enforcement&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;1 · Client (UX only)&lt;/b&gt; — AuthProvider caches AppUser; screens and buttons are hidden via userHasPermission().&lt;br/&gt;&lt;b&gt;2 · Firestore rules (real security)&lt;/b&gt; — every read/write re-reads users/{uid} and checks role ∈ allowed set &amp;amp;&amp;amp; active == true.&lt;br/&gt;&lt;br/&gt;Note: roles live in Firestore documents, &lt;b&gt;not&lt;/b&gt; in custom auth claims, so each rule evaluation costs an extra document read (billed, but free-tier friendly at this scale).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1000" y="380" width="320" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p4-emp" value="&lt;b&gt;Employee onboarding (separate from roles)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;employee-manager invites → employees/{id} with status &quot;invited&quot; + onboardingToken → employee completes profile (photo / proof / DOB / address, stored as base64 images/) → status &quot;active&quot;. Rules let an employee update &lt;i&gt;their own&lt;/i&gt; record during onboarding.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="700" y="430" width="260" height="160" as="geometry" />
        </mxCell>

        <mxCell id="p4-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p4-1" target="p4-2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e2" value="idToken" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;" edge="1" parent="1" source="p4-2" target="p4-3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p4-3" target="p4-4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p4-4" target="p4-5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e5" value="admin-app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;" edge="1" parent="1" source="p4-5" target="p4-a2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="495" /><mxPoint x="340" y="142" /></Array></mxGeometry></mxCell>
        <mxCell id="p4-e6" value="buyer-app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;" edge="1" parent="1" source="p4-5" target="p4-b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p4-a2" target="p4-a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e8" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;" edge="1" parent="1" source="p4-a3" target="p4-a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e9" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;" edge="1" parent="1" source="p4-a3" target="p4-a6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="235" /><mxPoint x="660" y="157" /></Array></mxGeometry></mxCell>
        <mxCell id="p4-e10" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;" edge="1" parent="1" source="p4-a4" target="p4-a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e11" value="re-sign-in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=9;" edge="1" parent="1" source="p4-a5" target="p4-a6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p4-b2" target="p4-b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p4-b3" target="p4-b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4-e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p4-b4" target="p4-b5"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===================================================================== -->
  <!-- PAGE 5 — FIRESTORE DATA MODEL                                         -->
  <!-- ===================================================================== -->
  <diagram id="page-data" name="5 · Firestore Data Model">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p5-title" value="Firestore Data Model (collections, key fields, relationships)" style="text;html=1;align=center;fontSize=19;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1390" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p5-shop" value="&lt;b&gt;shops/{shopId}&lt;/b&gt;&lt;hr/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;name&lt;br/&gt;salesDiscountPercent&lt;br/&gt;operatingHours[7]&lt;br/&gt;forceClosed&lt;br/&gt;upiVpa · upiPayeeName&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="600" y="70" width="210" height="130" as="geometry" />
        </mxCell>

        <mxCell id="p5-cat" value="&lt;b&gt;categories/{id}&lt;/b&gt;&lt;hr/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;shopId → shops&lt;br/&gt;name · order&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5-prod" value="&lt;b&gt;products/{id}&lt;/b&gt;&lt;hr/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;shopId · categoryId → categories&lt;br/&gt;name · description · unit&lt;br/&gt;price · discountPrice · priceUpdatedAt&lt;br/&gt;active · featured · perishable&lt;br/&gt;trackStock · stock · stockUpdatedAt&lt;br/&gt;onDemand · prepTime&lt;br/&gt;imageId → images&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p5-img" value="&lt;b&gt;images/{id}&lt;/b&gt;&lt;hr/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;base64 data (Cloud Storage avoided&lt;br/&gt;to stay on the Spark plan)&lt;br/&gt;cached client-side by use-cached-image&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="230" height="95" as="geometry" />
        </mxCell>

        <mxCell id="p5-cust" value="&lt;b&gt;customers/{uid}&lt;/b&gt;&lt;hr/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;shopId · uid (== doc id)&lt;br/&gt;name · email · phone · locale&lt;br/&gt;addresses[]: { id, label, door, street,&lt;br/&gt;&amp;nbsp;&amp;nbsp;city, pincode, landmark }&lt;br/&gt;defaultAddressId&lt;br/&gt;notifyBackInStock[] → productIds&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="260" width="250" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p5-order" value="&lt;b&gt;orders/{id}&lt;/b&gt;&lt;hr/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;shopId · customerId → customers&lt;br/&gt;customerName · customerPhone (snapshot)&lt;br/&gt;items[]: { productId, name, price, qty }&lt;br/&gt;subtotal · deliveryFee · couponCode&lt;br/&gt;discount · total · grandTotal · amountDelta&lt;br/&gt;paymentMode cod|upi · paymentStatus · upiRef&lt;br/&gt;address{} · pincode (snapshot)&lt;br/&gt;status: new|accepted|out_for_delivery|&lt;br/&gt;&amp;nbsp;&amp;nbsp;served|cancelled&lt;br/&gt;stockApplied · assignedTo → users&lt;br/&gt;note · statusLog[] · changeLog[]&lt;br/&gt;createdAt · reminders · lastRemindedAt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#ffcc99;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="600" y="470" width="290" height="245" as="geometry" />
        </mxCell>

        <mxCell id="p5-coupon" value="&lt;b&gt;coupons/{CODE}&lt;/b&gt;&lt;hr/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;shopId · discountType flat|percent|none&lt;br/&gt;value · maxDiscount&lt;br/&gt;freeDelivery · minOrder · active&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="990" y="470" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5-zone" value="&lt;b&gt;deliveryZones/{pincode}&lt;/b&gt;&lt;hr/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;serviceable · deliveryFee · freeAbove&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="990" y="610" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p5-user" value="&lt;b&gt;users/{uid}&lt;/b&gt;  ← RBAC source of truth&lt;hr/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;email · name · shopId&lt;br/&gt;role (legacy) · roles[] (union)&lt;br/&gt;active · createdAt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="990" y="70" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5-pending" value="&lt;b&gt;pendingUsers/{uid}&lt;/b&gt;&lt;hr/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;email · name · createdAt&lt;br/&gt;self-created role request&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="990" y="210" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5-emp" value="&lt;b&gt;employees/{id}&lt;/b&gt;&lt;hr/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;shopId · uid → users&lt;br/&gt;name · email · dob · address&lt;br/&gt;photoImageId · proofImageId → images&lt;br/&gt;status invited|active|disabled&lt;br/&gt;onboardingToken&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="990" y="320" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p5-push" value="&lt;b&gt;pushTokens/{uid}&lt;/b&gt;&lt;hr/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;token · kind admin|buyer&lt;br/&gt;role · roles[] · notify&lt;br/&gt;updatedAt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="600" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5-secrets" value="&lt;b&gt;secrets/{id}&lt;/b&gt;  ⚠&lt;hr/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;fast2sms API key&lt;br/&gt;readable by ANY signed-in user&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5-otp" value="&lt;b&gt;otps/{id}&lt;/b&gt;  ⚠&lt;hr/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;target · code · expiresAt&lt;br/&gt;attempts · consumed&lt;br/&gt;generated &amp;amp; verified client-side&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="210" height="95" as="geometry" />
        </mxCell>

        <mxCell id="p5-idx" value="&lt;b&gt;Composite indexes (firestore.indexes.json)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;categories: shopId, order&lt;br/&gt;products: shopId, name&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;shopId, categoryId, name&lt;br/&gt;employees: shopId, name&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;customers: shopId, name&lt;br/&gt;customers: shopId, notifyBackInStock (array-contains)&lt;br/&gt;orders: shopId, createdAt↓&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;shopId, status, createdAt↓&lt;br/&gt;orders: customerId, createdAt↓&lt;br/&gt;otps: target, consumed, createdAt↓&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="600" y="760" width="620" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p5-e1" value="shopId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;" edge="1" parent="1" source="p5-cat" target="p5-shop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e2" value="categoryId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;" edge="1" parent="1" source="p5-prod" target="p5-cat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e3" value="imageId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;" edge="1" parent="1" source="p5-prod" target="p5-img"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e4" value="customerId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;strokeWidth=2;" edge="1" parent="1" source="p5-order" target="p5-cust"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e5" value="items[].productId&lt;br/&gt;(denormalised snapshot)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;dashed=1;" edge="1" parent="1" source="p5-order" target="p5-prod"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="592" /><mxPoint x="420" y="310" /></Array></mxGeometry></mxCell>
        <mxCell id="p5-e6" value="couponCode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;" edge="1" parent="1" source="p5-order" target="p5-coupon"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e7" value="pincode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;" edge="1" parent="1" source="p5-order" target="p5-zone"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e8" value="assignedTo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;dashed=1;" edge="1" parent="1" source="p5-order" target="p5-user"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="592" /><mxPoint x="1300" y="125" /></Array></mxGeometry></mxCell>
        <mxCell id="p5-e9" value="approved into" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;dashed=1;" edge="1" parent="1" source="p5-pending" target="p5-user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e10" value="uid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;dashed=1;" edge="1" parent="1" source="p5-emp" target="p5-user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e11" value="same uid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;dashed=1;" edge="1" parent="1" source="p5-push" target="p5-cust"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e12" value="notifyBackInStock[]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;dashed=1;" edge="1" parent="1" source="p5-cust" target="p5-prod"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-e13" value="shopId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=open;" edge="1" parent="1" source="p5-cust" target="p5-shop"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===================================================================== -->
  <!-- PAGE 6 — BUILD & PLAY STORE RELEASE PIPELINE                          -->
  <!-- ===================================================================== -->
  <diagram id="page-release" name="6 · Build &amp; Play Store Release">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p6-title" value="Build &amp; Release Pipeline — from monorepo to Google Play" style="text;html=1;align=center;fontSize=19;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1390" height="40" as="geometry" />
        </mxCell>

        <!-- current state -->
        <mxCell id="p6-cur" value="CURRENT STATE (what you have today)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontStyle=1;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="400" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p6-c1" value="npm workspaces&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;common · admin-app · buyer-app&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="340" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p6-c2" value="scripts/build-apk.sh &amp;lt;admin|buyer&amp;gt; [debug|release]&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;ensure_jdk17 · ensure_android_sdk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="180" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-c3" value="npx expo prebuild --platform android&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;⚠ regenerates android/ — hand edits to&lt;br/&gt;build.gradle can be overwritten&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="255" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p6-c4" value="./gradlew assembleDebug / assembleRelease&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;→ app-debug.apk / app-release.apk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="340" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-c5" value="❌ NOT PUBLISHABLE&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• release block uses signingConfigs.debug&lt;br/&gt;• Play requires .aab, not .apk&lt;br/&gt;• versionCode is still 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="70" y="410" width="340" height="75" as="geometry" />
        </mxCell>

        <!-- release path -->
        <mxCell id="p6-rel" value="RELEASE PATH (what to do)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontStyle=1;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="70" width="440" height="860" as="geometry" />
        </mxCell>
        <mxCell id="p6-r1" value="1 · Create an upload keystore per app&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;keytool -genkeypair -v -keyalg RSA -keysize 2048&lt;br/&gt;-validity 10000 -alias upload -keystore upload.jks&lt;br/&gt;&lt;b&gt;back it up — losing it means losing the app&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="510" y="110" width="380" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p6-r2" value="2 · Wire the signing config so prebuild can&#39;t wipe it&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Option A (recommended): EAS Build — credentials&lt;br/&gt;managed remotely, eas build -p android --profile production&lt;br/&gt;Option B: commit android/ (bare workflow) + read the&lt;br/&gt;keystore path/password from ~/.gradle/gradle.properties or env&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="510" y="205" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p6-r3" value="3 · Bump versionCode / versionName&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;app.json expo.version + android.versionCode&lt;br/&gt;every upload needs a strictly higher versionCode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="510" y="320" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p6-r4" value="4 · Build an Android App Bundle&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;cd android &amp;amp;&amp;amp; ./gradlew bundleRelease&lt;br/&gt;→ app/build/outputs/bundle/release/app-release.aab&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="510" y="405" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p6-r5" value="5 · ⚠ CRITICAL — register the signing SHA-1 fingerprints&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Google Sign-In breaks on the Play build unless you add BOTH:&lt;br/&gt;• your &lt;b&gt;upload key&lt;/b&gt; SHA-1, and&lt;br/&gt;• the &lt;b&gt;Play App Signing key&lt;/b&gt; SHA-1 (Play Console → Setup → App signing)&lt;br/&gt;to Firebase Console → Project settings → Android app,&lt;br/&gt;then re-download google-services.json for BOTH apps.&lt;br/&gt;Today it only lists the Expo debug keystore hash.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="510" y="490" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p6-r6" value="6 · Play Console setup (per app)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;developer account ($25 one-off) → create app&lt;br/&gt;store listing · screenshots · feature graphic&lt;br/&gt;privacy policy URL (mandatory)&lt;br/&gt;Data safety form · content rating · target audience&lt;br/&gt;App access: supply reviewer test credentials&lt;br/&gt;(admin app also needs a pre-granted role)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="510" y="640" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6-r7" value="7 · Tracks: Internal testing → Closed testing → Production&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;new personal developer accounts must run closed testing&lt;br/&gt;with 12+ testers for 14 days before production access&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="510" y="770" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p6-r8" value="8 · 🚀 Live on Google Play" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="510" y="860" width="380" height="50" as="geometry" />
        </mxCell>

        <!-- backend deploy -->
        <mxCell id="p6-be" value="BACKEND DEPLOY (independent of the store)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontStyle=1;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="960" y="70" width="420" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p6-b1" value="firebase deploy --only firestore:rules,firestore:indexes&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;firebase.json points at firebase/firestore.rules + indexes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="990" y="110" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p6-b2" value="wrangler deploy (functions/notify)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;secrets: FIREBASE_SERVICE_ACCOUNT, GMAIL_CLIENT_ID,&lt;br/&gt;GMAIL_CLIENT_SECRET, GMAIL_REFRESH_TOKEN, GMAIL_SENDER&lt;br/&gt;cron trigger &quot;* * * * *&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="990" y="190" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6-b3" value="notifyUrl must point at the deployed Worker&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;set in app.local.json (gitignored), merged by app.config.js&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="990" y="290" width="360" height="65" as="geometry" />
        </mxCell>

        <!-- blockers -->
        <mxCell id="p6-blk" value="&lt;b&gt;⚠ Fix before the Production track&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1. Worker does not verify the ID-token signature → anyone can trigger pushes/emails.&lt;br/&gt;2. secrets/fast2sms is readable by every signed-in user → move the key to a Worker secret.&lt;br/&gt;3. OTP codes are generated and verified client-side in Firestore → move server-side or drop the feature.&lt;br/&gt;4. Admin app is staff-only: prefer Internal testing / Closed testing / Managed Google Play rather than a public Production listing.&lt;br/&gt;5. Data safety form must declare: name, email, phone, delivery address, purchase history, device push token.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="960" y="430" width="420" height="200" as="geometry" />
        </mxCell>

