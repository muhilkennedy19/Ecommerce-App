rules_version = '2';

// Role-based access control for the e-commerce apps.
// The user's role lives in /users/{uid}.role and is the single source of truth,
// mirroring the permission matrix in common/src/roles.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasUserDoc() {
      return isSignedIn() && exists(userPath());
    }
    function role() {
      return get(userPath()).data.role;
    }
    // All roles granted to the user: the `roles` array if present, else `[role]`.
    function userRoles() {
      return get(userPath()).data.get('roles', [role()]);
    }
    function isActive() {
      return get(userPath()).data.active == true;
    }
    // Superuser is unrestricted (support/admin) and is intentionally NOT subject to the
    // active flag — there must always be a way in. Checks both `role` and the `roles` array.
    function isSuperuser() {
      return hasUserDoc() && userRoles().hasAny(['superuser']);
    }
    // True if the signed-in user is a superuser, or an active user holding any role in `roles`.
    function roleIn(roles) {
      return isSuperuser() || (hasUserDoc() && isActive() && userRoles().hasAny(roles));
    }

    // ---- users (admin-side identities & roles) ----
    // Read: self, or any role-manager. Superuser: unrestricted.
    // Managers (admin / employee-manager): may grant/change NON-superuser roles on OTHER
    // users, and may not touch an existing superuser — only a superuser mints superusers.
    match /users/{uid} {
      allow read: if isSignedIn()
        && (request.auth.uid == uid || roleIn(['employee-manager', 'admin', 'superuser']));
      allow write: if isSuperuser();
      allow create, update: if roleIn(['employee-manager', 'admin'])
        && uid != request.auth.uid
        && request.resource.data.role != 'superuser'
        && !request.resource.data.get('roles', []).hasAny(['superuser'])
        && (resource == null || (resource.data.role != 'superuser'
          && !resource.data.get('roles', []).hasAny(['superuser'])));
    }

    // ---- pendingUsers (self-registered role requests) ----
    match /pendingUsers/{uid} {
      allow read: if isSignedIn()
        && (request.auth.uid == uid || roleIn(['employee-manager', 'admin', 'superuser']));
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if roleIn(['employee-manager', 'admin', 'superuser']);
    }

    // ---- shop config ----
    match /shops/{shopId} {
      allow read: if isSignedIn();
      allow write: if roleIn(['admin', 'superuser']);
    }

    // ---- catalog (readable by any signed-in user incl. buyers) ----
    match /categories/{id} {
      allow read: if isSignedIn();
      allow write: if roleIn(['product-manager', 'admin', 'superuser']);
    }
    match /products/{id} {
      allow read: if isSignedIn();
      allow write: if roleIn(['product-manager', 'superuser']);
    }

    // ---- employees ----
    // Employee managers (and admins) manage all; an employee may update their own record (onboarding).
    match /employees/{id} {
      allow read: if roleIn(['employee-manager', 'admin', 'superuser']);
      allow create, delete: if roleIn(['employee-manager', 'admin', 'superuser']);
      allow update: if roleIn(['employee-manager', 'admin', 'superuser'])
        || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ---- customers ----
    // Staff with customer access manage all; a buyer owns their own doc (id == uid).
    //
    // Loyalty is real money, so the wallet fields are NOT part of what a buyer may write:
    // points are minted only by the admin app (which holds customers.write) when an order is
    // served. A buyer's self-write must leave every wallet field byte-identical.
    function selfReferralCode() {
      return 'REF' + request.auth.uid[0:6].upper();
    }
    function touches(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    function walletUnchanged() {
      return !touches(['loyaltyPoints', 'referralSettled', 'referralCount']);
    }
    // A buyer may publish their own code, but only the one derived from their uid — this
    // mirrors referralCodeFor() in common/src/util/loyalty.ts, so nobody can claim another
    // person's code and divert their bonus.
    function referralCodeOk() {
      return !touches(['referralCode'])
        || request.resource.data.referralCode == selfReferralCode();
    }
    // `referredBy` may be set once (entering a friend's code) but never changed afterwards,
    // so a settled referral can't be re-pointed at someone else.
    function referredByOk() {
      return !touches(['referredBy'])
        || !('referredBy' in resource.data)
        || resource.data.referredBy == null;
    }
    match /customers/{id} {
      allow read: if roleIn(['customer-manager', 'admin', 'superuser'])
        || (isSignedIn() && request.auth.uid == id);
      allow create: if roleIn(['customer-manager', 'superuser'])
        || (isSignedIn() && request.auth.uid == id
            && !request.resource.data.keys().hasAny(['loyaltyPoints', 'referralSettled', 'referralCount'])
            && (!('referralCode' in request.resource.data)
                || request.resource.data.referralCode == selfReferralCode()));
      allow update: if roleIn(['customer-manager', 'superuser'])
        || (isSignedIn() && request.auth.uid == id
            && walletUnchanged() && referralCodeOk() && referredByOk());
      allow delete: if roleIn(['customer-manager', 'superuser']);
    }

    // ---- orders ----
    match /orders/{id} {
      // Buyer creates their own 'new' order; POS/staff create in-store sales (any status).
      allow create: if request.resource.data.shopId is string && (
        (isSignedIn()
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.status == 'new')
        || roleIn(['pos', 'sales', 'admin', 'superuser'])
      );
      allow read: if roleIn(['pos', 'sales', 'analytics', 'admin', 'superuser'])
        || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow update: if roleIn(['pos', 'sales', 'superuser'])
        || (isSignedIn()
          && resource.data.customerId == request.auth.uid
          && resource.data.status == 'new'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.total == resource.data.total
          && request.resource.data.grandTotal == resource.data.grandTotal
          && request.resource.data.items == resource.data.items
          && request.resource.data.get('paymentStatus', 'pending') == resource.data.get('paymentStatus', 'pending'));
      allow delete: if roleIn(['superuser']);
    }

    // ---- coupons (readable by any signed-in buyer to validate; managed by admins) ----
    match /coupons/{code} {
      allow read: if isSignedIn();
      allow write: if roleIn(['admin', 'superuser']);
    }

    // ---- reviews (product ratings) ----
    // Any signed-in user reads. A buyer writes ONLY their own review, at the deterministic
    // id `${productId}_${uid}` (so one review per buyer per product — no ballot-stuffing),
    // with a validated 1–5 integer rating. Updates require the existing doc to already be
    // theirs (can't overwrite someone else's). Content managers may remove a review.
    function validReview(id) {
      return request.resource.data.uid == request.auth.uid
        && id == request.resource.data.productId + '_' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
    }
    match /reviews/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && validReview(id);
      allow update: if isSignedIn() && validReview(id) && resource.data.uid == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.uid == request.auth.uid)
        || roleIn(['product-manager', 'admin', 'superuser']);
    }

    // ---- subscriptions (standing/scheduled orders; materialized by the notify Worker) ----
    // A buyer fully owns their own (customerId == uid). Order-servers may read to see upcoming
    // pickups. The Worker uses the service account and bypasses these rules.
    match /subscriptions/{id} {
      allow read: if roleIn(['sales', 'admin', 'superuser'])
        || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == resource.data.customerId;
      allow delete: if isSignedIn() && resource.data.customerId == request.auth.uid;
    }

    // ---- announcements (shop broadcasts shown on the buyer Home) ----
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if roleIn(['admin', 'superuser']);
    }

    // ---- delivery feedback (buyer rates a served order's delivery; admin-facing) ----
    // Buyer writes only their own, at the deterministic id = orderId, rating 1–5. Read is
    // limited to the owner and shop admins/superusers (the Feedback screen).
    match /deliveryFeedback/{id} {
      allow read: if roleIn(['admin', 'superuser'])
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.orderId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
    }

    // ---- delivery zones (serviceable pincodes + fees) ----
    match /deliveryZones/{pincode} {
      allow read: if isSignedIn();
      allow write: if roleIn(['admin', 'superuser']);
    }

    // ---- push tokens (owner-writable; the notify function reads via service account) ----
    match /pushTokens/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---- images (base64 blobs referenced by products/employees) ----
    // Readable by any signed-in user (buyers need product images); written by content managers.
    match /images/{id} {
      allow read: if isSignedIn();
      allow create, delete: if roleIn(['product-manager', 'employee-manager', 'admin', 'superuser']);
    }

    // ---- secrets (Fast2SMS key) ----
    // ⚠️ ACCEPTED-RISK: the buyer app reads this to send OTP, so any signed-in user can
    // read it. This exposes the third-party key to untrusted devices. Only the superuser
    // writes it. To secure: move OTP sending behind a server and restrict reads to none.
    match /secrets/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperuser();
    }

    // ---- otps (dev-grade) ----
    // Short-lived codes. Any signed-in user can create/verify. For production, move
    // generation + verification server-side so codes never live in client-readable docs.
    match /otps/{id} {
      allow read, create, update: if isSignedIn();
      allow delete: if roleIn(['superuser']);
    }
  }
}
