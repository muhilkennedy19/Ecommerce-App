        <mxCell id="p1-legend" value="&lt;b&gt;Legend&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; ▬ solid = synchronous call&amp;nbsp;&amp;nbsp;&amp;nbsp; ┄ dashed = fire-and-forget / best-effort&amp;nbsp;&amp;nbsp;&amp;nbsp; ⚠ = known risk to fix before public release" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="975" width="1380" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===================================================================== -->
  <!-- PAGE 2 — ORDER LIFECYCLE                                              -->
  <!-- ===================================================================== -->
  <diagram id="page-order" name="2 · Order Lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2-title" value="Order Lifecycle — buyer → Firestore → notify Worker → admin" style="text;html=1;align=center;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1340" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p2-l1" value="BUYER APP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="300" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="p2-l2" value="CLOUD FIRESTORE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="370" y="60" width="300" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="p2-l3" value="NOTIFY WORKER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="700" y="60" width="280" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="p2-l4" value="ADMIN APP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="1010" y="60" width="300" height="1000" as="geometry" />
        </mxCell>

        <mxCell id="p2-b1" value="1 · Sign in with Google" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="65" y="110" width="250" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2-b2" value="2 · Browse catalog&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;live onSnapshot(products where shopId, active)&lt;br/&gt;featured row · category filter · search&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="65" y="185" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-b3" value="3 · Add to cart&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;CartProvider (in-memory context)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="65" y="275" width="250" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2-b4" value="4 · Checkout&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;pick/create address → pincode lookup&lt;br/&gt;delivery fee (freeAbove) → coupon validate&lt;br/&gt;shop-open check (operatingHours / forceClosed)&lt;br/&gt;payment mode: COD or UPI deep link&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="65" y="350" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-b5" value="5 · placeOrder()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="65" y="470" width="250" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2-b9" value="11 · Order history updates live&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;onSnapshot(orders where customerId == uid&lt;br/&gt;order by createdAt desc) + paging&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="65" y="840" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2-b10" value="12 · 🔔 &quot;Order update&quot; push&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;+ bill email (Gmail)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="65" y="945" width="250" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p2-f1" value="customers/{uid}&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;upsertCustomerForUser()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="395" y="110" width="250" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2-f2" value="products / categories / images&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;readable by any signed-in user&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="395" y="185" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-f4" value="deliveryZones/{pincode}&lt;br/&gt;coupons/{CODE}&lt;br/&gt;shops/{shopId}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="395" y="350" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-f5" value="6 · orders/{id} created&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;status = &quot;new&quot;, paymentStatus = &quot;pending&quot;&lt;br/&gt;items[] + address + totals snapshotted&lt;br/&gt;statusLog[] seeded&lt;br/&gt;&lt;i&gt;rule: customerId must == request.auth.uid&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc99;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="395" y="460" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-f7" value="9 · acceptOrder() transaction&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;for each trackStock item: stock -= qty&lt;br/&gt;order.status = &quot;accepted&quot;&lt;br/&gt;stockApplied = true, assignedTo = uid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc99;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="395" y="700" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p2-f8" value="10 · edits &amp;amp; transitions&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;changeLog[] (type, by, note, delta)&lt;br/&gt;amountDelta accumulates refund / extra-pay&lt;br/&gt;cancel → restock if stockApplied&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="395" y="815" width="250" height="85" as="geometry" />
        </mxCell>

        <mxCell id="p2-w1" value="7 · POST notifyUrl&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;{ event: &quot;new-order&quot;, shopId, orderId }&lt;br/&gt;Bearer Firebase ID token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="460" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-w2" value="8 · resolve recipients&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;pushTokens where kind = &quot;admin&quot;&lt;br/&gt;∧ roles ∩ {sales, admin, superuser}&lt;br/&gt;∧ notify ≠ false&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="555" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p2-w3" value="FCM v1 high-priority send" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="655" width="240" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2-wcron" value="⏱ cron sweep (every minute)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;order still &quot;new&quot; after 30 s → re-ring&lt;br/&gt;up to 15 reminders, stamps lastRemindedAt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="725" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2-w4" value="POST { event: &quot;order-status&quot; }&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;→ pushTokens/{customerId}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="880" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p2-w5" value="POST { event: &quot;email&quot; }&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Gmail API → order bill&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="955" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p2-a1" value="🔔 Ring + banner&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;channel &quot;orders&quot; · IMPORTANCE_MAX&lt;br/&gt;order_ring.wav + vibration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1035" y="555" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2-a2" value="Orders list (live)&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;onSnapshot(orders, shopId + status, createdAt desc)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1035" y="640" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p2-a3" value="Accept order&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;requires permission orders.serve&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1035" y="715" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2-a4" value="Edit items · assign employee · change status&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;new → accepted → out_for_delivery → served&lt;br/&gt;(cancelled at any point → restock)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1035" y="790" width="250" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p2-a5" value="updateOrderStatus() → notify customer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1035" y="890" width="250" height="45" as="geometry" />
        </mxCell>

        <!-- Status machine inset -->
        <mxCell id="p2-sm" value="Order status machine:&amp;nbsp;&amp;nbsp; new → accepted → out_for_delivery → served&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; any → cancelled (restock if stockApplied)&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp; paymentStatus: pending → claimed → verified" style="text;html=1;align=center;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1070" width="1270" height="30" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="p2-eA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p2-b1" target="p2-f1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-eB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="p2-f2" target="p2-b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-eC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p2-b2" target="p2-b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-eD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p2-b3" target="p2-b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-eE" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;" edge="1" parent="1" source="p2-b4" target="p2-f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-eF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="p2-b4" target="p2-b5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-eG" value="addDoc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="p2-b5" target="p2-f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-eH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="p2-f5" target="p2-w1"><mxGeometry relative="1" as="geometry" /></mxCell>
