        <mxCell id="p1-e6" value="FCM HTTP v1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="p1-wk-http" target="p1-fb-fcm">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="690" /><mxPoint x="1450" y="185" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="p1-e7" value="REST read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;dashed=1;fontSize=9;" edge="1" parent="1" source="p1-wk-http" target="p1-ex-rest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e8" value="send mail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;dashed=1;fontSize=9;" edge="1" parent="1" source="p1-wk-http" target="p1-ex-gmail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e9" value="SA JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;dashed=1;fontSize=9;" edge="1" parent="1" source="p1-wk-http" target="p1-ex-oauth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e10" value="push delivery → devices" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontSize=9;" edge="1" parent="1" source="p1-fb-fcm" target="p1-c1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1258" y="60" /><mxPoint x="390" y="60" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="p1-e11" value="idToken" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;dashed=1;fontSize=9;" edge="1" parent="1" source="p1-cm-auth" target="p1-ex-gsi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e12" value="OTP send" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;dashed=1;fontSize=9;" edge="1" parent="1" source="p1-cm-otp" target="p1-ex-sms">
          <mxGeometry relative="1" as="geometry" />
